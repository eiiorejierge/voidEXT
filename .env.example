# Persistent storage (Upstash Redis REST or Vercel KV)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-rest-token

# Vercel KV uses these equivalent names instead:
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=replace-with-your-rest-token

# Required in production for /admin
ADMIN_KEY=replace-with-a-long-random-secret

NODE_ENV=production

# Link cloaking gateway (recommended in production)
# Public origin the /<token> links point at, and the domain that serves the app.
PUBLIC_BASE_URL=https://nebulabkmlinks.shop
# Secret that keys the opaque link tokens. Set a long random value so tokens
# cannot be guessed from the destination. Falls back to ADMIN_KEY if unset.
CLOAK_SECRET=replace-with-a-long-random-secret
# Max frame-ticket checks per IP per minute through the gateway (anti-scrape).
CLOAK_RESOLVE_LIMIT=120
